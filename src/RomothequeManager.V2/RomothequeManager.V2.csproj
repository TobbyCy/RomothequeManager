<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RomothequeManager.V2</AssemblyName>
    <!-- Official icon from the unchanged owner-approved Pilotage asset (#67). -->
    <ApplicationIcon>../../assets/branding/RM_V2_Favicon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="[12.1.4]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[12.1.4]" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="[10.0.14]" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fixtures/library-ui-v2-01b.synthetic.json" />
    <EmbeddedResource Include="../../contracts/demo-library-01/catalogue.json" LogicalName="DemoLibrary.Catalogue.json" />
    <EmbeddedResource Include="../../contracts/demo-library-01/scenarios.json" LogicalName="DemoLibrary.Scenarios.json" />
    <Content Include="../../assets/branding/RM_V2_Horizontal_Fond_Sombre.png" Link="RM_V2_Horizontal_Fond_Sombre.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <Content Include="../../assets/branding/RM_V2_Favicon.ico" Link="RM_V2_Favicon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
