<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RomothequeManager.V2.MvvmFoundation"
        xmlns:inv="using:RomothequeManager.V2.Inventory"
        x:Class="RomothequeManager.V2.MvvmFoundation.InventoryPreviewWindow"
        x:DataType="vm:InventoryViewModel"
        x:CompileBindings="True"
        Title="ROMothèque Manager · NEXT-03 MVVM · SIMULATION"
        Width="1120" Height="720" MinWidth="760" MinHeight="480"
        Background="#16181D" Foreground="#E8E6E3">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
      <Image x:Name="BrandImage" Width="230" Height="66"
             HorizontalAlignment="Left" Stretch="Uniform" />
      <Border Background="#38262B" BorderBrush="#A9444B"
              BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="5">
          <TextBlock FontSize="19" FontWeight="Bold" Text="NEXT-03 — PRÉVISUALISATION MVVM · DONNÉES SIMULÉES" TextWrapping="Wrap" />
          <TextBlock Text="Aucun dossier, fichier ROM ou média n’est inspecté. Les observations et états ci-dessous sont inventés pour vérifier la présentation. Aucune identité de jeu reconnue." TextWrapping="Wrap" />
          <TextBlock Text="Le vrai service DEV 1 et le parcours intégré Bibliothèques → Collection restent en attente. Aucun scan personnel n'est possible depuis cette fenêtre." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Background="#23262B" CornerRadius="8" Padding="15">
        <StackPanel Spacing="9">
          <TextBlock Text="1 · Choisir un dossier (sélection seule, aucune analyse)" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" />
          <Button Content="Choisir un dossier local…" Click="ChooseFolder_OnClick"
                  IsEnabled="{Binding CanChangeFolder}" MinHeight="40" />
          <TextBlock Text="{Binding SelectedLocalRoot, FallbackValue='Aucun dossier choisi'}"
                     TextWrapping="Wrap" />
          <TextBlock Text="Portée future : ROMS/ uniquement · noms, extensions, tailles, dates, playlists .m3u bornées · aucune écriture." TextWrapping="Wrap" />
          <TextBlock Text="Préflight limité à la sélection et scan réel : DÉSACTIVÉS dans ce simulateur." TextWrapping="Wrap" />
          <TextBlock Text="2 · Choisir l'état à visualiser" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" />
          <ComboBox x:Name="PreviewCase" SelectionChanged="PreviewCase_OnSelectionChanged"
                    IsEnabled="{Binding CanChangeFolder}" SelectedIndex="0">
            <ComboBoxItem Content="Complete — données fictives" />
            <ComboBoxItem Content="Partial — couverture incomplète" />
            <ComboBoxItem Content="Failed — échec simulé" />
            <ComboBoxItem Content="Offline — support simulé déconnecté" />
            <ComboBoxItem Content="Stale — preuve simulée obsolète" />
          </ComboBox>
          <TextBlock Text="3 · Confirmation distincte de la sélection" FontWeight="Bold" FontSize="18" TextWrapping="Wrap" />
          <CheckBox Content="Je confirme le lancement d’une SIMULATION (aucune lecture du dossier)"
                    IsChecked="{Binding ConsentConfirmed, Mode=TwoWay}"
                    IsEnabled="{Binding CanChangeFolder}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Simuler l'inventaire" Command="{Binding StartInventoryCommand}" MinHeight="40"/>
            <Button Content="Annuler" Command="{Binding CancelInventoryCommand}" MinHeight="40"/>
          </StackPanel>
          <ProgressBar Height="7" Minimum="0" Maximum="100"
                       IsVisible="{Binding IsBusy}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="#23262B" CornerRadius="8" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="Bold" Text="4 · Résultats simulés / couverture" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Dernier complet" Command="{Binding ShowLastCompleteCommand}"/>
            <Button Content="Dernière tentative" Command="{Binding ShowLastAttemptCommand}"/>
          </StackPanel>
          <TextBlock Text="{Binding ScanStatusText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ObservedFilesText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding TotalFilesText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding IdentifiedGamesText}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SourceLabel}" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Text="Disponibilité :"/>
            <TextBlock Text="{Binding AvailabilityText}"/>
            <TextBlock Text="Fraîcheur :"/>
            <TextBlock Text="{Binding FreshnessText}"/>
          </StackPanel>
          <TextBlock Text="Portées réellement couvertes PAR LA SIMULATION :" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding Coverage}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="inv:InventoryCoverage">
                <TextBlock Text="{Binding PartitionKey}" Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Background="#23262B" CornerRadius="8" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="Bold" FontSize="18" Text="Collection / Fichiers observés — SIMULATION" TextWrapping="Wrap" />
          <ListBox ItemsSource="{Binding Observations}"
                   SelectedItem="{Binding SelectedObservation, Mode=TwoWay}"
                   MinHeight="90" MaxHeight="230">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="inv:FileObservation">
                <StackPanel Margin="3" Spacing="2">
                  <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Kind}" Opacity="0.7"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Observation sélectionnée · chemin relatif :" FontWeight="Bold" />
          <TextBlock Text="{Binding SelectedObservation.RelativePath, FallbackValue='Aucune observation sélectionnée'}" TextWrapping="Wrap"/>
          <TextBlock Text="Aucune fiche jeu, correspondance ES-DE, action de copie, dédoublonnage ou suppression n’est proposée." TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Background="#23262B" CornerRadius="8" Padding="15">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="Bold" FontSize="18" Text="Diagnostics — SIMULATION" />
          <ItemsControl ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="inv:InventoryDiagnostic">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Code}"/>
                  <TextBlock Text="{Binding Reason}" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Pour revenir au Dashboard et à l'import ES-DE existants, fermer cette fenêtre. Aucun état ne sera conservé après sa fermeture." TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
