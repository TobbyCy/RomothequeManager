<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RomothequeManager.V2.MvvmFoundation"
        xmlns:inv="using:RomothequeManager.V2.Inventory"
        x:Class="RomothequeManager.V2.MvvmFoundation.ObservedLibraryWindow"
        x:CompileBindings="False"
        Title="ROMothèque Manager · Inventaire des fichiers observés"
        Width="1120" Height="720" MinWidth="760" MinHeight="480"
        Background="#16181D" Foreground="#E8E6E3">
  <ScrollViewer x:Name="RootScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
      <Image x:Name="OfficialLogo" Width="230" Height="66" HorizontalAlignment="Left" Stretch="Uniform"/>
      <Border Background="#38262B" BorderBrush="#A9444B" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="5">
          <TextBlock FontSize="20" FontWeight="Bold" Text="NEXT-05 · INVENTAIRE AUTONOME DES FICHIERS" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ModeNotice}" TextWrapping="Wrap"/>
          <TextBlock Text="Fichier observé ≠ jeu identifié ≠ association candidate. Aucun XML ES-DE nécessaire." TextWrapping="Wrap"/>
          <TextBlock Text="Sans persistance active : la session en cours disparaît à la fermeture. Aucun fichier source modifié." TextWrapping="Wrap" IsVisible="{Binding HasLiveMediaPanel}"/>
        </StackPanel>
      </Border>
      <Border x:Name="RestoredStatusPanel" Background="#24333E" BorderBrush="#667A8B"
              BorderThickness="1" CornerRadius="8" Padding="14" IsVisible="{Binding HasRestoredSession}">
        <StackPanel Spacing="8">
          <TextBlock FontSize="18" FontWeight="Bold" Text="Collection SQLite sauvegardée · consultation hors ligne"/>
          <TextBlock x:Name="RestoredStatusBanner" Text="{Binding RestoredSession.StatusLabel}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding RestoredSession.AttemptLabel}" TextWrapping="Wrap"/>
          <WrapPanel>
            <Button Content="Dernier complet sauvegardé" Command="{Binding RestoredSession.ShowCompleteCommand}"
                    MinHeight="40" Margin="0,0,8,4"/>
            <Button Content="Dernière tentative sauvegardée" Command="{Binding RestoredSession.ShowAttemptCommand}"
                    MinHeight="40"/>
          </WrapPanel>
          <TextBlock Text="OFFLINE / STALE : aucune présence actuelle, aucun scan ni aperçu automatique."
                     TextWrapping="Wrap" Foreground="#C2CED9"/>
        </StackPanel>
      </Border>
      <Border x:Name="RsAUiPanel" Background="#243029" BorderBrush="#638B74"
              BorderThickness="1" CornerRadius="8" Padding="14"
              IsVisible="{Binding HasRsA}">
        <Border.Styles>
          <!-- Scoped RS-A controls: explicit legible colors in all interaction states. -->
          <Style Selector="Button">
            <Setter Property="Foreground" Value="#F2F8F2"/>
            <Setter Property="Background" Value="#385242"/>
            <Setter Property="BorderBrush" Value="#9AC6A3"/>
            <Setter Property="BorderThickness" Value="1"/>
          </Style>
          <Style Selector="Button:disabled">
            <Setter Property="Foreground" Value="#C5D0C7"/>
            <Setter Property="Background" Value="#304037"/>
            <Setter Property="BorderBrush" Value="#718B78"/>
          </Style>
          <Style Selector="Button:focus">
            <Setter Property="BorderBrush" Value="#C6FFDC"/>
            <Setter Property="BorderThickness" Value="2"/>
          </Style>
          <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#F2F8F2"/>
          </Style>
          <Style Selector="CheckBox:checked">
            <Setter Property="Foreground" Value="#F2F8F2"/>
          </Style>
          <Style Selector="CheckBox:focus">
            <Setter Property="Foreground" Value="#FFFFFF"/>
          </Style>
          <Style Selector="CheckBox:disabled">
            <Setter Property="Foreground" Value="#C5D0C7"/>
          </Style>
        </Border.Styles>
        <StackPanel Spacing="9">
          <TextBlock FontSize="19" FontWeight="Bold" Text="RS-A · ROMS WINDOWS · FIXTURES UNIQUEMENT"
                     TextWrapping="Wrap"/>
          <TextBlock Text="Le choix ne donne aucun accès. Consentement éphémère et lecture de métadonnées confinée par le backend RS-A ; ROMothèque personnelle interdite."
                     TextWrapping="Wrap"/>
          <WrapPanel>
            <Button x:Name="RsASelectButton" Content="1 · Choisir ROMS fictif"
                    Click="RsASelect_OnClick" IsEnabled="{Binding RsA.CanSelect}"
                    MinHeight="40" Margin="0,0,8,4"/>
            <TextBlock x:Name="RsASelectionLabel" Text="{Binding RsA.SelectedRootLabel}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
          </WrapPanel>
          <CheckBox x:Name="RsAConsentCheckbox"
                    Content="2 · Je consens à un scan ponctuel de cette fixture ROMS, sans accès personnel"
                    IsChecked="{Binding RsA.ConsentConfirmed, Mode=TwoWay}"
                    IsEnabled="{Binding RsA.HasSelection}" MinHeight="35"/>
          <WrapPanel>
            <Button x:Name="RsAStartButton" Content="3 · Start (une seule tentative)"
                    Command="{Binding RsA.StartCommand}" IsEnabled="{Binding RsA.CanStart}"
                    MinHeight="40" Margin="0,0,8,4"/>
            <Button x:Name="RsACancelButton" Content="Cancel / Révoquer"
                    Command="{Binding RsA.CancelCommand}" IsEnabled="{Binding RsA.CanCancel}"
                    MinHeight="40" Margin="0,0,8,4"/>
            <Button Content="Dernier complet" Command="{Binding RsA.ShowCompleteCommand}"
                    MinHeight="40" Margin="0,0,8,4"/>
            <Button Content="Dernière tentative" Command="{Binding RsA.ShowAttemptCommand}"
                    MinHeight="40"/>
          </WrapPanel>
          <ProgressBar Height="7" IsVisible="{Binding RsA.IsBusy}" IsIndeterminate="{Binding RsA.IsBusy}"/>
          <TextBlock x:Name="RsAPhaseLabel" FontWeight="Bold" Text="{Binding RsA.PhaseLabel}"
                     TextWrapping="Wrap"/>
          <TextBlock x:Name="RsAProgressLabel" Text="{Binding RsA.ProgressLabel}"
                     TextWrapping="Wrap"/>
          <TextBlock Text="{Binding RsA.SnapshotLabel}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding RsA.SafeDiagnostic}" Foreground="#B8CBC0" TextWrapping="Wrap"/>
          <TextBlock Text="OFFLINE / STALE n'autorise jamais la reprise automatique. SQLite et les choix de jaquettes restent indépendants."
                     Foreground="#B8CBC0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border x:Name="LiveInventoryPanel" Background="#23262B" CornerRadius="8"
              Padding="15" IsVisible="{Binding HasLiveMediaPanel}">
        <StackPanel Spacing="9">
          <TextBlock Text="1 · Choisir → confirmer → inventorier en lecture seule" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
          <WrapPanel>
            <Button x:Name="ChooseFolderButton" Content="Choisir une racine (sélection seule)" Click="ChooseFolder_OnClick" IsEnabled="{Binding Inventory.CanChangeFolder}" MinHeight="40" Margin="0,0,8,4"/>
            <ComboBox x:Name="FixtureChoices" IsVisible="False" SelectedIndex="0" MinWidth="220" Margin="0,0,8,4">
              <ComboBoxItem Content="IDEAL · fictive"/>
              <ComboBoxItem Content="CHAOS · fictive"/>
              <ComboBoxItem Content="MYSTERY · sans XML"/>
            </ComboBox>
            <Button x:Name="ChooseFixtureButton" IsVisible="False" Content="Sélectionner cette fixture" Click="ChooseFixture_OnClick" MinHeight="40"/>
          </WrapPanel>
          <TextBlock Text="{Binding Inventory.SelectedLocalRoot, FallbackValue='Aucune sélection'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ScopeText}" TextWrapping="Wrap" Foreground="#AAB2BF"/>
          <CheckBox Content="Je confirme la lecture seule de la fixture autorisée (aucun accès personnel)" IsChecked="{Binding Inventory.ConsentConfirmed, Mode=TwoWay}" IsEnabled="{Binding Inventory.CanChangeFolder}"/>
          <WrapPanel>
            <Button x:Name="InventoryStartButton" Content="Inventorier en lecture seule" Command="{Binding Inventory.StartInventoryCommand}" IsEnabled="{Binding CanInventoryFixture}" MinHeight="40" Margin="0,0,8,4"/>
            <Button Content="Annuler" Command="{Binding Inventory.CancelInventoryCommand}" MinHeight="40"/>
            <Button Content="Dernier complet" Command="{Binding Inventory.ShowLastCompleteCommand}" MinHeight="40" Margin="0,0,8,4"/>
            <Button Content="Dernière tentative" Command="{Binding Inventory.ShowLastAttemptCommand}" MinHeight="40"/>
          </WrapPanel>
          <ProgressBar IsVisible="{Binding Inventory.IsBusy}" IsIndeterminate="{Binding Inventory.IsProgressIndeterminate}" Height="7"/>
          <TextBlock Text="{Binding Inventory.StatusMessage}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Inventory.LatestAttemptText}" Foreground="#AAB2BF" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding GenerationLabel}" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="Navigation clavier : Tab, Maj+Tab, Entrée/Espace, flèches dans la Collection. Fenêtre défilante à 760×480." Foreground="#AAB2BF" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <WrapPanel>
        <Button Content="Tableau de bord" Command="{Binding ShowDashboardCommand}" MinHeight="40" Margin="0,0,8,4"/>
        <Button Content="Collection de fichiers" Command="{Binding ShowCollectionCommand}" MinHeight="40" Margin="0,0,8,4"/>
        <Button Content="Fiche sélectionnée" Command="{Binding OpenFileCommand}" MinHeight="40"/>
      </WrapPanel>
      <Border Background="#23262B" CornerRadius="8" Padding="16" IsVisible="{Binding IsDashboard}">
        <StackPanel Spacing="11">
          <TextBlock FontSize="23" FontWeight="Bold" Text="Tableau de bord · fichiers observés"/>
          <TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SnapshotStatus}" TextWrapping="Wrap"/>
          <TextBlock Text="Plateformes observées" FontWeight="Bold"/>
          <TextBlock Text="{Binding PlatformSummary}" TextWrapping="Wrap"/>
          <TextBlock Text="Extensions observées" FontWeight="Bold"/>
          <TextBlock Text="{Binding ExtensionSummary}" TextWrapping="Wrap"/>
          <TextBlock Text="Types de fichiers" FontWeight="Bold"/>
          <TextBlock Text="{Binding TypeSummary}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding DiagnosticSummary}" TextWrapping="Wrap"/>
          <TextBlock Text="Une observation ne prouve ni la jouabilité, ni l'identité commerciale, ni la présence d'un jeu unique." TextWrapping="Wrap" Foreground="#AAB2BF"/>
          <Button Content="Consulter les fichiers observés" Command="{Binding ShowCollectionCommand}" MinHeight="40"/>
        </StackPanel>
      </Border>
      <Border Background="#23262B" CornerRadius="8" Padding="16" IsVisible="{Binding IsCollection}">
        <StackPanel Spacing="10">
          <TextBlock FontSize="23" FontWeight="Bold" Text="Collection · fichiers observés"/>
          <TextBlock Text="Noms de fichiers provisoires uniquement. Aucun titre commercial ni jaquette déduit." TextWrapping="Wrap"/>
          <TextBox Watermark="Rechercher un nom ou un chemin relatif" Text="{Binding SearchText, Mode=TwoWay}" MinHeight="40"/>
          <WrapPanel>
            <StackPanel Margin="0,0,12,6" Spacing="3">
              <TextBlock Text="Plateforme"/>
              <ComboBox ItemsSource="{Binding PlatformOptions}" SelectedItem="{Binding PlatformFilter, Mode=TwoWay}" MinWidth="155"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Spacing="3">
              <TextBlock Text="Extension"/>
              <ComboBox ItemsSource="{Binding ExtensionOptions}" SelectedItem="{Binding ExtensionFilter, Mode=TwoWay}" MinWidth="155"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Spacing="3">
              <TextBlock Text="Type"/>
              <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding KindFilter, Mode=TwoWay}" MinWidth="155"/>
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="{Binding PageText}" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap"/>
          <ListBox x:Name="ObservedList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MinHeight="90" MaxHeight="280">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="inv:InventoryObservationRow">
                <StackPanel Margin="4" Spacing="3">
                  <TextBlock Text="{Binding ProvisionalLabel}" FontWeight="Bold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding Observation.RelativePath}" Foreground="#AAB2BF" TextWrapping="Wrap"/>
                  <WrapPanel>
                    <TextBlock Text="{Binding Observation.PlatformKey}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Observation.Extension}" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding Observation.Kind}"/>
                  </WrapPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <WrapPanel>
            <Button Content="← Page précédente" Command="{Binding PreviousPageCommand}" MinHeight="40" Margin="0,0,8,4"/>
            <Button Content="Page suivante →" Command="{Binding NextPageCommand}" MinHeight="40" Margin="0,0,8,4"/>
            <Button Content="Ouvrir la fiche du fichier sélectionné" Command="{Binding OpenFileCommand}" MinHeight="40"/>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Background="#23262B" CornerRadius="8" Padding="16" IsVisible="{Binding IsFileDetail}">
        <StackPanel Spacing="9">
          <Button Content="← Retour à la collection" Command="{Binding ReturnCollectionCommand}" MinHeight="40"/>
          <TextBlock FontSize="23" FontWeight="Bold" Text="Fiche · fichier observé" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedName}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="Nom de fichier provisoire, pas un titre de jeu identifié." Foreground="#AAB2BF" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedRow.Observation.RelativePath}" TextWrapping="Wrap"/>
          <WrapPanel>
            <TextBlock Text="Plateforme : " FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedRow.Observation.PlatformKey}" Margin="0,0,12,0"/>
            <TextBlock Text="Extension : " FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedRow.Observation.Extension}"/>
          </WrapPanel>
          <WrapPanel>
            <TextBlock Text="Type : " FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedRow.Observation.Kind}" Margin="0,0,12,0"/>
            <TextBlock Text="Disponibilité à la capture : " FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedRow.Observation.Availability}"/>
          </WrapPanel>
          <TextBlock Text="{Binding SelectedRow.Observation.SizeBytes, StringFormat='Taille observée : {0} octets'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedRow.Observation.ModifiedUtc, StringFormat='Date fichier : {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding SelectedRow.Observation.SourceKind, StringFormat='Source : {0}'}" TextWrapping="Wrap"/>
          <TextBlock Text="Identifiant d'observation (non durable)" FontWeight="Bold"/>
          <TextBlock Text="{Binding SelectedRow.Observation.ObservationId}" TextWrapping="Wrap"/>
          <TextBlock Text="Diagnostics référencés" FontWeight="Bold"/>
          <ItemsControl ItemsSource="{Binding SelectedRow.Observation.DiagnosticRefs}"/>
          <TextBlock Text="Jeu identifié : non établi · aucune identité commerciale certifiée." TextWrapping="Wrap"/>
          <TextBlock Text="Association candidate : non établie · aucun rapprochement automatique." TextWrapping="Wrap"/>
          <TextBlock Text="{Binding MediaNotice}" TextWrapping="Wrap"/>
          <Border x:Name="RestoredCoverPanel" IsVisible="{Binding HasRestoredSession}"
                  Background="#1B1F25" BorderBrush="#667A8B" BorderThickness="1"
                  CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock FontSize="18" FontWeight="Bold" Text="Jaquette · association manuelle SQLite"/>
              <TextBlock x:Name="RestoredCoverStatus" Text="{Binding RestoredSession.CurrentChoiceLabel}"
                         FontWeight="Bold" TextWrapping="Wrap"/>
              <TextBlock Text="Candidates historiques d'une racine MEDIAS fictive. Aucune image chargée ni présence actuelle certifiée."
                         TextWrapping="Wrap"/>
              <ListBox x:Name="SavedCoverChoices" ItemsSource="{Binding RestoredSession.Candidates}"
                       SelectedItem="{Binding RestoredSession.SelectedCandidate, Mode=TwoWay}"
                       MinHeight="65" MaxHeight="175">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SavedCoverCandidate">
                    <TextBlock Text="{Binding Caption}" Margin="5" TextWrapping="Wrap"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <CheckBox Content="Je confirme explicitement cette décision sur la fixture fictive"
                        Foreground="#E8EEF5"
                        IsChecked="{Binding RestoredSession.Confirmation, Mode=TwoWay}"/>
              <WrapPanel>
                <Button Content="Enregistrer l'association" Command="{Binding RestoredSession.SaveCommand}"
                        MinHeight="40" Margin="0,0,8,4"/>
                <Button Content="Révoquer le choix actuel" Command="{Binding RestoredSession.RevokeCommand}"
                        MinHeight="40"/>
              </WrapPanel>
              <TextBlock x:Name="RestoredSaveStatus" Text="{Binding RestoredSession.SaveStatus}"
                         TextWrapping="Wrap"/>
              <TextBlock Text="Choix historiques uniquement : pas de preview, modification ROM/MEDIAS ni rapprochement automatique."
                         Foreground="#AAB2BF" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border x:Name="MediaPanel" IsVisible="{Binding HasLiveMediaPanel}" Background="#1B1F25" BorderBrush="#424A54" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Médias locaux · preuves et aperçus" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
              <TextBlock Text="Aucune jaquette associée automatiquement. Un aperçu ne constitue pas une approbation." Foreground="#AAB2BF" TextWrapping="Wrap"/>
              <TextBlock x:Name="MediaEvidenceStatus" Text="{Binding Media.EvidenceStatus}" FontWeight="Bold" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Media.EvidenceDetails}" TextWrapping="Wrap"/>
              <TextBlock Text="Candidats et galerie indépendante · choisir explicitement une image :" FontWeight="Bold" TextWrapping="Wrap"/>
              <ListBox x:Name="MediaChoicesList" ItemsSource="{Binding Media.Choices}"
                       SelectedItem="{Binding Media.SelectedChoice, Mode=TwoWay}"
                       MinHeight="65" MaxHeight="185">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MediaChoice">
                    <StackPanel Margin="4" Spacing="2">
                      <TextBlock Text="{Binding Caption}" FontWeight="Bold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Provenance}" Foreground="#AAB2BF" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Content="Aperçu du média sélectionné" Command="{Binding Media.PreviewCommand}"
                        IsEnabled="{Binding Media.CanPreview}" MinHeight="40" Margin="0,0,8,4"/>
                <Button Content="Annuler / effacer l'aperçu" Command="{Binding Media.CancelCommand}" MinHeight="40"/>
              </WrapPanel>
              <TextBlock x:Name="MediaPreviewStatusText" Text="{Binding Media.PreviewStatus}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Media.Diagnostic}" Foreground="#AAB2BF" TextWrapping="Wrap"/>
              <Image x:Name="MediaPreviewImage" Width="290" Height="210" HorizontalAlignment="Left" Stretch="Uniform"/>
              <TextBlock Text="Ajout manuel, décision d'association et sauvegarde après redémarrage : non disponibles dans ce lot." Foreground="#AAB2BF" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <Border Background="#23262B" CornerRadius="8" Padding="16">
        <StackPanel Spacing="7">
          <TextBlock FontSize="18" FontWeight="Bold" Text="Couverture et diagnostics"/>
          <TextBlock Text="{Binding SnapshotStatus}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding Coverage}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="inv:InventoryCoverage">
                <WrapPanel Margin="0,2">
                  <TextBlock Text="{Binding PartitionKey}" Margin="0,0,12,0"/>
                  <TextBlock Text="{Binding Status}"/>
                </WrapPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding DiagnosticSummary}" FontWeight="Bold" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding Diagnostics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="inv:InventoryDiagnostic">
                <StackPanel Spacing="2" Margin="0,5">
                  <WrapPanel>
                    <TextBlock Text="{Binding Severity}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Code}"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Foreground="#AAB2BF"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Une couverture incomplète, une panne ou un support hors ligne ne prouve jamais la suppression de fichiers." TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
